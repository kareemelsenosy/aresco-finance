# Copy to .env and fill in.

# --- Audit assistant (optional; everything else works without it) ---
LLM_ORDER=openai,anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- App ---
DATABASE_URL=sqlite:///./aresco_finance.db
UPLOAD_DIR=./uploads
BASE_CURRENCY=EGP

# Warn when projected daily cash falls below this EGP figure
SHORTAGE_BUFFER_EGP=0

# ── ACCESS CONTROL ─────────────────────────────────────────────
# Signs session cookies and verification codes. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SECRET_KEY=change-this-to-a-long-random-string

# Only addresses at this domain may register or sign in.
ALLOWED_EMAIL_DOMAIN=aresco.com.eg
SESSION_HOURS=12
CODE_TTL_MINUTES=15

# ── OUTBOUND MAIL (sign-up verification codes) ─────────────────
# Leave SMTP_HOST empty and the code is written to the server log
# instead of being emailed — fine for a first run, not for real use.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aresco.com.eg
SMTP_STARTTLS=true
SMTP_SSL=false
